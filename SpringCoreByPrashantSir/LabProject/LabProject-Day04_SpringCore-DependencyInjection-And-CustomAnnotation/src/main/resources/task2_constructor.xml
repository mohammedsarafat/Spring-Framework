<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="department" class="com.nit.model.Department">
        <constructor-arg value="102" />
        <constructor-arg value="HR" />
        <constructor-arg value="London" />
    </bean>

    <bean id="employee" class="com.nit.model.Employee">
        <constructor-arg value="1002" />
        <constructor-arg value="Jane Smith" />
        <constructor-arg value="65000.0" />
        <constructor-arg ref="department" />
    </bean>

</beans>
