<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="department" class="com.nit.model.Department">
        <property name="departmentId" value="101" />
        <property name="departmentName" value="IT" />
        <property name="departmentLocation" value="New York" />
    </bean>

    <bean id="employee" class="com.nit.model.Employee">
        <property name="employeeId" value="1001" />
        <property name="employeeName" value="John Doe" />
        <property name="employeeSalary" value="75000.0" />
        <property name="department" ref="department" />
    </bean>

</beans>
